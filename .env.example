# =====================================================================
# Contabilidade Praça — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite valores reais.
# =====================================================================

# --- Tracking / Analytics (TODO: preencher antes do go-live) ---------
# Google Analytics 4
NEXT_PUBLIC_GA_ID=

# Google Ads — ID da conta de conversão (formato AW-XXXXXXXXXX)
NEXT_PUBLIC_GADS_ID=
# Google Ads — label da conversão (formato XXXXXXXXX/XxXxXxXxXx)
NEXT_PUBLIC_GADS_CONVERSION_LABEL=

# Meta (Facebook) Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# --- Site --------------------------------------------------------------
# URL canônica de produção (sem barra final). Ex.: https://contabilidadepraca.com.br
NEXT_PUBLIC_SITE_URL=https://contabilidadepraca.com.br

# --- Integração do formulário /api/lead (server-side, NÃO public) ------
# Evolution API (WhatsApp) — opcional, hoje o endpoint é stub
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# E-mail de destino dos leads do formulário (opcional)
LEAD_NOTIFICATION_EMAIL=
